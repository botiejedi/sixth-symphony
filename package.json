{
  "name": "6th-symphony",
  "private": true,
  "version": "0.0.0",
  "description": "AI tab sorter for Vivaldi — extension + memory sidecar.",
  "workspaces": [
    "extension",
    "sidecar",
    "shared"
  ],
  "scripts": {
    "build:extension": "npm --workspace extension run build",
    "dev:extension": "npm --workspace extension run dev",
    "test:extension": "npm --workspace extension run test -- --run",
    "test:smoke": "node --test tests/smoke/*.test.mjs",
    "dev:sidecar": "npm --workspace sidecar run dev",
    "test:sidecar": "npm --workspace sidecar run test -- --run",
    "test:shared": "npm --workspace shared run test -- --run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.1",
    "drizzle-orm": "^0.36.4"
  }
}
